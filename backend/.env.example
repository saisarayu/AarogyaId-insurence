# Backend Environment Variables
# Copy this file to .env and fill in your values

# REQUIRED: Your OpenAI API key
OPENAI_API_KEY=sk-...

# ChromaDB vector store directory (relative to backend/)
CHROMA_PERSIST_DIR=./chromadb

# ChromaDB collection name
CHROMA_COLLECTION_NAME=insurance_policies

# MongoDB connection string (optional — app works without Mongo)
MONGODB_URI=mongodb://localhost:27017
MONGO_DB_NAME=insurance_db
MONGO_COLLECTION_NAME=policies

# Chunk sizes for text splitting
MAX_CHUNK_SIZE=500
MIN_CHUNK_SIZE=400
