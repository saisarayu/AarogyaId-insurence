# OpenAI API key used by ChatOpenAI and embeddings.
OPENAI_API_KEY=your-openai-api-key

# Persistent Chroma database directory.
CHROMA_PERSIST_DIR=./chromadb

# Chroma collection name used for storing insurance policy chunks.
CHROMA_COLLECTION_NAME=insurance_policies

# MongoDB connection used only for policy metadata.
MONGODB_URI=mongodb://localhost:27017
MONGO_DB_NAME=insurance_db
MONGO_COLLECTION_NAME=policies
